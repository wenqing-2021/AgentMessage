[Unit]
Description=Feishu bridge for Codex and Qoder CLI tasks
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@AGENT_MESSAGE_WORKING_DIRECTORY@
EnvironmentFile=@AGENT_MESSAGE_ENV_FILE@
Environment=@AGENT_MESSAGE_PATH@
ExecStart=@AGENT_MESSAGE_EXEC_START@
Restart=on-failure
RestartSec=5
KillMode=control-group
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
UMask=0077

[Install]
WantedBy=default.target
